# Copiez ce fichier en .env (non versionné) puis complétez-le.

POSTGRES_PASSWORD=change-moi
DATABASE_URL=postgresql://postgres:change-moi@typebot-db:5432/typebot

# 32 caractères exactement : python -c "import secrets; print(secrets.token_hex(16))"
ENCRYPTION_SECRET=

# Adresses publiques de l'éditeur et du lecteur.
NEXTAUTH_URL=http://localhost:8080
NEXT_PUBLIC_VIEWER_URL=http://127.0.0.1:8081

# Compte administrateur ; DISABLE_SIGNUP empêche d'autres inscriptions.
ADMIN_EMAIL=
DISABLE_SIGNUP=true

# La connexion à l'éditeur se fait par lien envoyé par e-mail : SMTP Brevo.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
NEXT_PUBLIC_SMTP_FROM=

# En local seulement : autorise les blocs HTTP request à joindre Django sur la machine hôte
SSRF_ALLOWED_HOSTS=giu-api
