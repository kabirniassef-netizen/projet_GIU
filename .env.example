# Développement local. Copiez ce fichier en .env.
DEBUG=True
SECRET_KEY=your-secret-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# Configuration de la base de données
# SQLite est utilisé localement par défaut.
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

# Production PostgreSQL : configurez ces valeurs dans l'environnement de déploiement.
# Render peut fournir l'URL PostgreSQL via DATABASE_URL.
# DATABASE_URL=
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=giu
# DB_USER=giu_user
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=5432

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000

# E-mail notifications
# En développement, les e-mails sont affichés dans la console.
# En production, configurez EMAIL_BACKEND et les identifiants SMTP dans l'environnement.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=notifications@example.com

# Chatbot (voir docs/chatbot-typebot.md)
# Typebot open source auto-hébergé (deploy/typebot/). La bulle n'apparaît que si
# l'identifiant public du bot et l'adresse du viewer sont renseignés.
TYPEBOT_ID=
TYPEBOT_API_HOST=http://127.0.0.1:8081
# Clé secrète envoyée par le bot dans l'en-tête X-Chatbot-Key (quota dédié).
CHATBOT_API_KEY=
CHATBOT_THROTTLE_RATE=300/hour

# Sécurité
# Laissez ces surcharges absentes pour utiliser les valeurs dépendant de DEBUG.
CSRF_TRUSTED_ORIGINS=

# Logging
LOG_LEVEL=DEBUG

# Répertoire des téléversements; Render utilise un disque persistant.
# MEDIA_ROOT=/var/data/media
